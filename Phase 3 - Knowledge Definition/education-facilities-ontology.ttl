@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix edu:    <http://kg2026.unitn.it/ontology/education#> .
@prefix schema: <https://schema.org/> .
@prefix vivo:  <http://vivoweb.org/ontology/core#> .

#################################################################
# Ontology
#################################################################

edu: a owl:Ontology ;
    rdfs:label "Territory and Education Facilities Ontology" ;
    rdfs:comment "KG 2026 project #6: educational institutions and municipalities in the Trentino area." .

#################################################################
# Classes
#################################################################

edu:Municipality a owl:Class ;
    rdfs:label "Municipality" ;
    rdfs:subClassOf schema:AdministrativeArea ;
    rdfs:seeAlso vivo:GeographicLocation .

edu:EducationalInstitution a owl:Class ;
    rdfs:label "Educational Institution" ;
    rdfs:subClassOf schema:EducationalOrganization ;
    rdfs:seeAlso vivo:Organization .

edu:Kindergarten a owl:Class ;
    rdfs:label "Kindergarten" ;
    rdfs:subClassOf edu:EducationalInstitution .

edu:PrimarySchool a owl:Class ;
    rdfs:label "Primary School" ;
    rdfs:subClassOf edu:EducationalInstitution .

edu:SecondarySchool a owl:Class ;
    rdfs:label "Secondary School" ;
    rdfs:subClassOf edu:EducationalInstitution .

edu:HigherEducationInstitution a owl:Class ;
    rdfs:label "Higher Education Institution" ;
    rdfs:subClassOf edu:EducationalInstitution , schema:CollegeOrUniversity .

edu:GeoFeature a owl:Class ;
    rdfs:label "Geographic Feature" .

edu:NaturalLandmark a owl:Class ;
    rdfs:label "Natural Landmark" ;
    rdfs:subClassOf edu:GeoFeature .

#################################################################
# Object properties
#################################################################

edu:locatedIn a owl:ObjectProperty ;
    rdfs:label "located in" ;
    rdfs:domain edu:EducationalInstitution ;
    rdfs:range edu:Municipality .

edu:near a owl:ObjectProperty ;
    rdfs:label "near" ;
    rdfs:domain edu:EducationalInstitution ;
    rdfs:range edu:GeoFeature ;
    rdfs:comment "Conceptual relation only; no landmark or coordinate data is available in the current sources." .

edu:hasEducationalInstitution a owl:ObjectProperty ;
    rdfs:label "has educational institution" ;
    rdfs:domain edu:Municipality ;
    rdfs:range edu:EducationalInstitution ;
    owl:inverseOf edu:locatedIn .

#################################################################
# Data properties
#################################################################

edu:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain edu:EducationalInstitution , edu:Municipality , edu:GeoFeature ;
    rdfs:range xsd:string .

edu:address a owl:DatatypeProperty ;
    rdfs:label "address" ;
    rdfs:domain edu:EducationalInstitution ;
    rdfs:range xsd:string .

edu:ownershipType a owl:DatatypeProperty ;
    rdfs:label "ownership type" ;
    rdfs:domain edu:EducationalInstitution ;
    rdfs:range xsd:string ;
    rdfs:comment "Enumerated values: public, religious, lay (source values Pubblico / Religioso / Laico)." .

edu:schoolLevel a owl:DatatypeProperty ;
    rdfs:label "school level" ;
    rdfs:domain edu:EducationalInstitution ;
    rdfs:range xsd:string ;
    rdfs:comment "Enumerated values: kindergarten, primary, secondary, higher." .

edu:istatCode a owl:DatatypeProperty ;
    rdfs:label "ISTAT code" ;
    rdfs:domain edu:Municipality ;
    rdfs:range xsd:string .

edu:area a owl:DatatypeProperty ;
    rdfs:label "area" ;
    rdfs:domain edu:Municipality ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Surface area of the municipality." .

#################################################################
# Data properties: counts of schools per municipality
# Source: number_scuole_*.csv (school year 2012/2013).
#################################################################

edu:kindergartenCount a owl:DatatypeProperty ;
    rdfs:label "kindergarten count" ;
    rdfs:domain edu:Municipality ;
    rdfs:range xsd:integer ;
    rdfs:comment "Number of kindergartens (scuole dell'infanzia) in the municipality, school year 2012/2013." .

edu:primarySchoolCount a owl:DatatypeProperty ;
    rdfs:label "primary school count" ;
    rdfs:domain edu:Municipality ;
    rdfs:range xsd:integer ;
    rdfs:comment "Number of primary schools (scuole primarie) in the municipality, school year 2012/2013." .

edu:lowerSecondarySchoolCount a owl:DatatypeProperty ;
    rdfs:label "lower secondary school count" ;
    rdfs:domain edu:Municipality ;
    rdfs:range xsd:integer ;
    rdfs:comment "Number of lower secondary schools (scuole secondarie di primo grado) in the municipality, school year 2012/2013." .

edu:upperSecondarySchoolCount a owl:DatatypeProperty ;
    rdfs:label "upper secondary school count" ;
    rdfs:domain edu:Municipality ;
    rdfs:range xsd:integer ;
    rdfs:comment "Number of upper secondary schools (scuole secondarie di secondo grado) in the municipality, school year 2012/2013." .
