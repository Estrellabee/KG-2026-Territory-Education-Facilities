@prefix edu: <http://knowdive.disi.unitn.it/etype#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix vivo: <http://vivoweb.org/ontology/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

edu: a owl:Ontology ;
    rdfs:label "Territory and Education Facilities Ontology (aligned)" ;
    rdfs:comment """KG 2026 project #6: educational institutions and municipalities in the Trentino area.\r
\r
This file is the Application Context Level (TLO/ETG) of the project. It extends the\r
inception ontology of Phase 3 with explicit alignment axioms to the Knowledge Teleology\r
(KTLO) and Language Teleology (LTLO) supplied by the course, and to the schema.org\r
reference fragment.\r
\r
The alignment is deliberately limited to what the project data can support: classes are\r
declared as subclasses of the corresponding KTLO classes, and only those properties whose\r
KTLO counterpart has a compatible type are declared as subproperties. Properties that have\r
no counterpart in the supplied fragments (geometry relations, ownership, school level,\r
per-municipality school counts) are kept in the project namespace and documented as\r
project extensions.""" ;
    owl:imports <https://raw.githubusercontent.com/Estrellabee/KG-2026-Territory-Education-Facilities/main/fragments/KTLO-KG.owl>,
        <https://raw.githubusercontent.com/Estrellabee/KG-2026-Territory-Education-Facilities/main/fragments/LTLO-KG.owl>,
        <https://raw.githubusercontent.com/Estrellabee/KG-2026-Territory-Education-Facilities/main/fragments/full-schema-org.owl> .

edu:HigherEducationInstitution a owl:Class ;
    rdfs:label "Higher Education Institution" ;
    rdfs:comment "a high school comprising many faculties, where specialists are trained [UKC-24619]. a high school comprising many faculties, where specialists are trained [UKC-24619]. Aligned to ktlo:university, a sibling of ktlo:school and ktlo:kindergarten under ktlo:education." ;
    rdfs:subClassOf edu:EducationalInstitution,
        <http://www.semanticweb.org/lixiaoyue/ontologies/2023/2/untitled-ontology-26#university>,
        schema:CollegeOrUniversity .

edu:Kindergarten a owl:Class ;
    rdfs:label "Kindergarten" ;
    rdfs:comment "a preschool for children age 4 to 6 to prepare them for primary school [UKC-44658]. a preschool for children age 4 to 6 to prepare them for primary school [UKC-44658]. Aligned to ktlo:kindergarten, which in the KTLO is a sibling of ktlo:school under ktlo:education." ;
    rdfs:subClassOf edu:EducationalInstitution,
        <http://www.semanticweb.org/lixiaoyue/ontologies/2023/2/untitled-ontology-26#kindergarten> .

edu:NaturalLandmark a owl:Class ;
    rdfs:label "Natural Landmark" ;
    rdfs:comment "no UKC equivalent: UKC has no natural-landmark concept, kept as a custom project term. no UKC equivalent: UKC has no natural-landmark concept, kept as a custom project term. Aligned to ktlo:natural (lakes, peaks, glaciers, ...). Instantiated as a class only: no landmark coordinates are available in the supplied datasets, so CQ2 cannot be answered with data." ;
    rdfs:subClassOf edu:GeoFeature,
        <http://www.semanticweb.org/lixiaoyue/ontologies/2023/2/untitled-ontology-26#natural> .

edu:PrimarySchool a owl:Class ;
    rdfs:label "Primary School" ;
    rdfs:comment "a school for children where they receive the first stage of basic education [UKC-44664]. a school for children where they receive the first stage of basic education [UKC-44664]. No dedicated KTLO class exists for primary schools; the alignment is inherited from edu:EducationalInstitution (subclass of ktlo:school)." ;
    rdfs:subClassOf edu:EducationalInstitution .

edu:SecondarySchool a owl:Class ;
    rdfs:label "Secondary School" ;
    rdfs:comment "a school for students intermediate between primary school and tertiary school [UKC-44031]. a school for students intermediate between primary school and tertiary school [UKC-44031]. No dedicated KTLO class exists for secondary schools; the alignment is inherited from edu:EducationalInstitution (subclass of ktlo:school)." ;
    rdfs:subClassOf edu:EducationalInstitution .

edu:hasEducationalInstitution a owl:ObjectProperty ;
    rdfs:label "has educational institution" ;
    rdfs:comment "declared as the inverse of edu:has_municipality; UKC models concepts and not relations, so no identifier is attached and the term stays a project extension (tier 3)" ;
    rdfs:domain edu:Municipality ;
    rdfs:range edu:EducationalInstitution ;
    owl:inverseOf edu:has_municipality .

edu:has_address a owl:DatatypeProperty ;
    rdfs:label "address" ;
    rdfs:comment "the address where a person or organization can be communicated with [UKC-45005]. the address where a person or organization can be communicated with [UKC-45005]. Project extension. schema:address in the supplied fragment is declared as an object property (because schema.org allows both a text and a PostalAddress value), so it cannot be used as the super-property of a datatype property without breaking the logic. The correspondence is documented in the report instead." ;
    rdfs:domain edu:EducationalInstitution ;
    rdfs:range xsd:string .

edu:has_area a owl:DatatypeProperty ;
    rdfs:label "area" ;
    rdfs:comment "Surface area of the municipality. the extent of a 2-dimensional surface enclosed within a boundary [UKC-27784]. Surface area of the municipality. the extent of a 2-dimensional surface enclosed within a boundary [UKC-27784]. Project extension (surface area in km2). schema:area exists in the supplied fragment but is declared as an object property, so no sub-property axiom is added." ;
    rdfs:domain edu:Municipality ;
    rdfs:range xsd:decimal .

edu:has_istatCode a owl:DatatypeProperty ;
    rdfs:label "ISTAT code" ;
    rdfs:comment "a system of symbols used to represent information [UKC-33626]. a system of symbols used to represent information [UKC-33626]. Aligned to ktlo:code, the identifier property of ktlo:openstreetmap_place. The ISTAT code is the official identifier of a municipality." ;
    rdfs:domain edu:Municipality ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://www.semanticweb.org/lixiaoyue/ontologies/2023/2/untitled-ontology-26#code> .

edu:has_kindergartenCount a owl:DatatypeProperty ;
    rdfs:label "kindergarten count" ;
    rdfs:comment "Number of kindergartens (scuole dell'infanzia) in the municipality, school year 2012/2013. the act of determining the quantity of something [UKC-3211]. Number of kindergartens (scuole dell'infanzia) in the municipality, school year 2012/2013. the act of determining the quantity of something [UKC-3211]. Number of kindergartens (scuole dell'infanzia) in the municipality, school year 2012/2013. Project extension: the KTLO only offers ktlo:population for places, which does not cover counts of facilities." ;
    rdfs:domain edu:Municipality ;
    rdfs:range xsd:integer .

edu:has_lowerSecondarySchoolCount a owl:DatatypeProperty ;
    rdfs:label "lower secondary school count" ;
    rdfs:comment "Number of lower secondary schools (scuole secondarie di primo grado) in the municipality, school year 2012/2013. the act of determining the quantity of something [UKC-3211]. Number of lower secondary schools (scuole secondarie di primo grado) in the municipality, school year 2012/2013. the act of determining the quantity of something [UKC-3211]. Number of lower secondary schools (scuole secondarie di primo grado) in the municipality, school year 2012/2013. Project extension." ;
    rdfs:domain edu:Municipality ;
    rdfs:range xsd:integer .

edu:has_name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:comment "a word by which a person or thing is known [UKC-2]. a word by which a person or thing is known [UKC-2]. Aligned to ktlo:name, the property the KTLO itself uses for every openstreetmap_place. Because all project classes are declared below ktlo:openstreetmap_place, the KTLO domain restriction is satisfied." ;
    rdfs:domain edu:EducationalInstitution,
        edu:GeoFeature,
        edu:Municipality ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://www.semanticweb.org/lixiaoyue/ontologies/2023/2/untitled-ontology-26#name> .

edu:has_ownershipType a owl:DatatypeProperty ;
    rdfs:label "ownership type" ;
    rdfs:comment "Enumerated values: public, religious, lay (source values Pubblico / Religioso / Laico). the state of being an owner of something [UKC-62515]. Enumerated values: public, religious, lay (source values Pubblico / Religioso / Laico). the state of being an owner of something [UKC-62515]. Project extension. Enumerated values: public, religious, lay (source values Pubblico / Religioso / Laico). No counterpart in KTLO or schema.org." ;
    rdfs:domain edu:EducationalInstitution ;
    rdfs:range xsd:string .

edu:has_primarySchoolCount a owl:DatatypeProperty ;
    rdfs:label "primary school count" ;
    rdfs:comment "Number of primary schools (scuole primarie) in the municipality, school year 2012/2013. the act of determining the quantity of something [UKC-3211]. Number of primary schools (scuole primarie) in the municipality, school year 2012/2013. the act of determining the quantity of something [UKC-3211]. Number of primary schools (scuole primarie) in the municipality, school year 2012/2013. Project extension." ;
    rdfs:domain edu:Municipality ;
    rdfs:range xsd:integer .

edu:has_proximity a owl:ObjectProperty ;
    rdfs:label "near" ;
    rdfs:comment "Conceptual relation only; no landmark or coordinate data is available in the current sources. custom relation; no UKC or KTLO equivalent, left unpopulated. Conceptual relation only; no landmark or coordinate data is available in the current sources. custom relation; no UKC or KTLO equivalent, left unpopulated. Conceptual relation only; no landmark or coordinate data is available in the current sources. No equivalent exists in KTLO, LTLO or schema.org fragments, therefore it is declared as a project extension." ;
    rdfs:domain edu:EducationalInstitution ;
    rdfs:range edu:GeoFeature .

edu:has_schoolLevel a owl:DatatypeProperty ;
    rdfs:label "school level" ;
    rdfs:comment "Enumerated values: kindergarten, primary, secondary, higher. a relative position in a scale or hierarchy [UKC-19654]. Enumerated values: kindergarten, primary, secondary, higher. a relative position in a scale or hierarchy [UKC-19654]. Project extension. Enumerated values: kindergarten, primary, secondary, higher. The KTLO encodes school level as classes (ktlo:kindergarten, ktlo:school, ktlo:university) rather than as a datatype property, so this property duplicates class membership for query convenience." ;
    rdfs:domain edu:EducationalInstitution ;
    rdfs:range xsd:string .

edu:has_upperSecondarySchoolCount a owl:DatatypeProperty ;
    rdfs:label "upper secondary school count" ;
    rdfs:comment "Number of upper secondary schools (scuole secondarie di secondo grado) in the municipality, school year 2012/2013. the act of determining the quantity of something [UKC-3211]. Number of upper secondary schools (scuole secondarie di secondo grado) in the municipality, school year 2012/2013. the act of determining the quantity of something [UKC-3211]. Number of upper secondary schools (scuole secondarie di secondo grado) in the municipality, school year 2012/2013. Project extension." ;
    rdfs:domain edu:Municipality ;
    rdfs:range xsd:integer .

edu:has_municipality a owl:ObjectProperty ;
    rdfs:label "located in" ;
    rdfs:comment "aligned to schema:containedInPlace; UKC provides no relation for it. aligned to schema:containedInPlace; UKC provides no relation for it. Project extension, aligned to schema:containedInPlace. The KTLO has no containment relation: it is a taxonomy of place types, so this relation cannot be inherited from it." ;
    rdfs:domain edu:EducationalInstitution ;
    rdfs:range edu:Municipality ;
    rdfs:subPropertyOf schema:containedInPlace .

edu:GeoFeature a owl:Class ;
    rdfs:label "Geographic Feature" ;
    rdfs:comment "a demarcated area of the Earth [UKC-45324]. a demarcated area of the Earth [UKC-45324]. Introduction class for the geographical branch. Aligned to the root of the KTLO class tree so that every geographical feature of the project stays inside the supplied ontology." ;
    rdfs:subClassOf <http://www.semanticweb.org/lixiaoyue/ontologies/2023/2/untitled-ontology-26#openstreetmap_place> .

edu:Municipality a owl:Class ;
    rdfs:label "Municipality" ;
    rdfs:comment "an urban district having corporate status and powers of self-government [UKC-45537]. an urban district having corporate status and powers of self-government [UKC-45537]. A comune of the Autonomous Province of Trento. Aligned to ktlo:places, the settlement branch of the KTLO, because a municipality is a populated place; aligned to schema:AdministrativeArea because it is also an administrative unit." ;
    rdfs:seeAlso vivo:GeographicLocation ;
    rdfs:subClassOf <http://www.semanticweb.org/lixiaoyue/ontologies/2023/2/untitled-ontology-26#places>,
        schema:AdministrativeArea .

edu:EducationalInstitution a owl:Class ;
    rdfs:label "Educational Institution" ;
    rdfs:comment "an institution dedicated to education [UKC-43985]. an institution dedicated to education [UKC-43985]. Aligned to ktlo:school. In the KTLO the path is ktlo:school < ktlo:education < ktlo:public < ktlo:pois < ktlo:openstreetmap_place." ;
    rdfs:seeAlso vivo:Organization ;
    rdfs:subClassOf <http://www.semanticweb.org/lixiaoyue/ontologies/2023/2/untitled-ontology-26#school>,
        schema:EducationalOrganization .

